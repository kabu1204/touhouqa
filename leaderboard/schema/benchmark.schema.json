{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://touhouqa.dev/schema/benchmark.schema.json",
  "title": "TouhouQA Benchmark",
  "type": "object",
  "required": ["id", "name", "language", "primary_metric", "question_count", "status", "grading", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^touhouqa-(core|test)-v[0-9]+$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "language": { "type": "string", "enum": ["zh"] },
    "primary_metric": { "type": "string", "enum": ["accuracy"] },
    "question_count": { "type": "integer", "minimum": 1 },
    "split": { "type": "string", "enum": ["test"] },
    "subset": { "type": "string", "enum": ["core", "full"] },
    "status": { "type": "string", "enum": ["active", "deprecated"] },
    "artifacts": {
      "type": "object",
      "properties": {
        "questions_public": { "type": ["string", "null"] },
        "questions_sha256": { "type": ["string", "null"] },
        "gold_private": { "type": "string" },
        "gold_sha256": { "type": ["string", "null"] },
        "filter_report": { "type": "string" },
        "manifest": { "type": "string" }
      }
    },
    "grading": {
      "type": "object",
      "required": ["method", "module"],
      "properties": {
        "method": { "type": "string", "enum": ["exact_match"] },
        "module": { "type": "string" },
        "normalize": { "type": "array", "items": { "type": "string" } }
      }
    },
    "created_at": { "type": "string" },
    "deprecated_at": { "type": ["string", "null"] },
    "superseded_by": { "type": ["string", "null"] }
  }
}
