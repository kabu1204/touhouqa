{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://touhouqa.dev/schema/entry.schema.json",
  "title": "TouhouQA Leaderboard Entry",
  "type": "object",
  "required": [
    "id",
    "benchmark_id",
    "model",
    "model_id",
    "metrics",
    "run",
    "artifacts",
    "status",
    "submitted_at"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "benchmark_id": { "type": "string" },
    "model": { "type": "string" },
    "model_id": { "type": "string" },
    "organization": { "type": ["string", "null"] },
    "parameters_billion": { "type": ["number", "null"] },
    "tier": { "type": "string", "enum": ["official", "community", "experimental"] },
    "metrics": {
      "type": "object",
      "required": ["accuracy", "correct", "total", "missing_predictions", "extra_predictions"],
      "properties": {
        "accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "correct": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 },
        "missing_predictions": { "type": "integer", "minimum": 0 },
        "extra_predictions": { "type": "integer", "minimum": 0 }
      }
    },
    "breakdown": {
      "type": "object",
      "properties": {
        "by_domain": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["accuracy", "correct", "total"],
            "properties": {
              "accuracy": { "type": "number" },
              "correct": { "type": "integer" },
              "total": { "type": "integer" }
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "required": ["inference", "completed_at"],
      "properties": {
        "touhouqa_repo_commit": { "type": "string" },
        "eval_command": { "type": "string" },
        "inference": {
          "type": "object",
          "required": ["provider", "model_id", "temperature", "prompt_template_id"],
          "properties": {
            "provider": { "type": "string" },
            "api_base": { "type": "string" },
            "model_id": { "type": "string" },
            "temperature": { "type": "number" },
            "max_tokens": { "type": "integer" },
            "prompt_template_id": { "type": "string" },
            "prompt_sha256": { "type": "string" }
          }
        },
        "seed": { "type": "integer" },
        "completed_at": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["predictions_sha256", "eval_report"],
      "properties": {
        "predictions_path": { "type": "string" },
        "predictions_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "eval_report": { "type": "string" },
        "eval_report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "repository_url": { "type": "string" }
      }
    },
    "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
    "submitted_at": { "type": "string" },
    "verified_at": { "type": ["string", "null"] },
    "notes": { "type": "string" }
  }
}
