{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://touhouqa.dev/schema/eval_report.schema.json",
  "title": "TouhouQA Eval Report",
  "type": "object",
  "required": ["benchmark_id", "total", "correct", "accuracy", "missing_predictions", "extra_predictions"],
  "properties": {
    "benchmark_id": { "type": "string" },
    "gold_sha256": { "type": "string" },
    "predictions_sha256": { "type": "string" },
    "total": { "type": "integer", "minimum": 0 },
    "correct": { "type": "integer", "minimum": 0 },
    "accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
    "missing_predictions": { "type": "integer", "minimum": 0 },
    "extra_predictions": { "type": "integer", "minimum": 0 },
    "by_topic": { "type": "object", "additionalProperties": { "$ref": "#/$defs/topicStats" } },
    "by_domain": { "type": "object", "additionalProperties": { "$ref": "#/$defs/topicStats" } },
    "evaluated_at": { "type": "string" },
    "touhouqa_commit": { "type": "string" }
  },
  "$defs": {
    "topicStats": {
      "type": "object",
      "required": ["correct", "total", "accuracy"],
      "properties": {
        "correct": { "type": "integer" },
        "total": { "type": "integer" },
        "accuracy": { "type": "number" }
      }
    }
  }
}
