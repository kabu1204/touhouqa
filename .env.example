# Copy this file to `.env` (create it next to this file) and fill in your values.
#
# IMPORTANT: Do NOT commit `.env` (it contains secrets).

# OpenAI / OpenAI-compatible gateway settings
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# API style: responses | chat_completions | auto
OPENAI_API=responses

# Reasoning effort (optional; only affects compatible models)
# Examples: minimal | low | medium | high | xhigh
OPENAI_REASONING_EFFORT=

# Parallelism (how many concurrent LLM requests to run)
OPENAI_PARALLELISM=4
# Backpressure: max number of in-flight LLM requests before waiting (0 = auto = 2*parallelism)
OPENAI_MAX_IN_FLIGHT=0

# Model name used when --llm_generate_qa is enabled (can also be passed via --llm_model)
OPENAI_MODEL=gpt-4o-mini


